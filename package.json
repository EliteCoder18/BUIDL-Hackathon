{
  "name": "trustfutures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/*.test.mjs tests/contracts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:contracts": "node --test tests/contracts/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "api": "node services/api/server.mjs",
    "deploy:testnets": "node scripts/deploy.mjs",
    "test:watch": "node --test --watch tests/**/*.test.mjs",
    "lint": "node --check services/domain/policy.mjs",
    "deploy:preflight": "node scripts/deploy.mjs --preflight",
    "smoke:testnets": "node scripts/testnet-loop.mjs",
    "sync:testnets": "node scripts/sync-testnet-manifest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "ganache": "^7.9.2",
    "solc": "^0.8.30",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "^0.1.2",
    "@gluwa/usc-sdk": "^0.18.0",
    "ethers": "^6.15.0",
    "openai": "^6.49.0",
    "pg": "^8.23.0"
  }
}
